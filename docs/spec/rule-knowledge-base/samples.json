  "clauses": [
    {
      "clause_uid": "RULE-4800-2026-001#第2章 日前市场/2.5",
      "doc_id": "RULE-4800-2026-001",
      "chapter_path": "第2章 日前市场",
      "clause_no": "2.5",
      "clause_key": "第2章 日前市场/2.5",
      "clause_seq": 1,
      "clause_topic": "OTHER",
      "applicable_subject": [
        "MARKET_OPERATOR",
        "DISPATCH_ORG"
      ],
      "trade_type": [
        "SPOT"
      ],
      "time_scope_from": null,
      "time_scope_to": null,
      "text_raw": "D-1 日 20:30 前，电力调度机构基于经营主体申报信息以及运行日的电网运行边界条件，采用安全约束机组组合（SCUC）、安全约束经济调度（SCED）程序进行优化计算，出清得到日前市场出清结果。",
      "text_norm": "D-1 日 20:30 前,电力调度机构基于经营主体申报信息以及运行日的电网运行边界条件,采用安全约束机组组合(SCUC)、安全约束经济调度(SCED)程序进行优化计算,出清得到日前市场出清结果。",
      "text_hash": "149bc4244ec813c1a231cf498ba27b258bb6763b0bc23750d8bb67b99c3092a7",
      "char_count": 98,
      "page_ref": "p.30 §2.5",
      "text_status": "VERBATIM",
      "notes": "出清流程条款"
    },
    {
      "clause_uid": "RULE-4800-2026-001#第2章 日前市场/2.7.1.1",
      "doc_id": "RULE-4800-2026-001",
      "chapter_path": "第2章 日前市场",
      "clause_no": "2.7.1.1",
      "clause_key": "第2章 日前市场/2.7.1.1",
      "clause_seq": 2,
      "clause_topic": "SETTLEMENT_PRICE",
      "applicable_subject": [
        "GENERATOR"
      ],
      "trade_type": [
        "SPOT"
      ],
      "time_scope_from": null,
      "time_scope_to": null,
      "text_raw": "发电侧的日前电能量市场出清形成每 15 分钟的节点电价，每小时内 4 个 15 分钟的节点电价的算术平均值，计为该节点每小时的平均节点电价。日前电能量市场中，发电机组以机组所在节点的小时平均节点电价作为相应时段的结算价格。",
      "text_norm": "发电侧的日前电能量市场出清形成每 15 分钟的节点电价,每小时内 4 个 15 分钟的节点电价的算术平均值,计为该节点每小时的平均节点电价。日前电能量市场中,发电机组以机组所在节点的小时平均节点电价作为相应时段的结算价格。",
      "text_hash": "9f9e02c5268f91033cbed30be6da6c9e7406c850613e0d1ebc0be31433508971",
      "char_count": 111,
      "page_ref": "p.37 §2.7.1.1",
      "text_status": "VERBATIM",
      "notes": null
    },
    {
      "clause_uid": "RULE-4800-2026-001#第2章 日前市场/2.2.11.5",
      "doc_id": "RULE-4800-2026-001",
      "chapter_path": "第2章 日前市场",
      "clause_no": "2.2.11.5",
      "clause_key": "第2章 日前市场/2.2.11.5",
      "clause_seq": 3,
      "clause_topic": "PRICE_CAP_FLOOR",
      "applicable_subject": [
        "GENERATOR",
        "SALE_COMPANY"
      ],
      "trade_type": [
        "SPOT"
      ],
      "time_scope_from": null,
      "time_scope_to": null,
      "text_raw": "当市场出清得到的节点电价超过市场出清价格上限时，该节点在该交易时段的节点电价用市场出清价格上限代替。当市场出清得到的节点电价低于市场出清价格下限时，该节点在该交易时段的节点电价用市场出清价格下限代替。",
      "text_norm": "当市场出清得到的节点电价超过市场出清价格上限时,该节点在该交易时段的节点电价用市场出清价格上限代替。当市场出清得到的节点电价低于市场出清价格下限时,该节点在该交易时段的节点电价用市场出清价格下限代替。",
      "text_hash": "ad6e5e30f68ffb590f5ff756895fa29a3e4561d3c0e330ea1e8aa809aa55dea9",
      "char_count": 100,
      "page_ref": "p.12 §2.2.11.5",
