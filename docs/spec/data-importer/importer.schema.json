    "I03": "BLOCK",
    "I04": "BLOCK",
    "I05": "BLOCK",
    "I06": "WARN",
    "W09": "WARN"
  },
  "rule_meaning": {
    "Q01": "必需字段为空（object-map required=是）",
    "Q02": "同一业务键重复（批内 DUP_IN_BATCH）",
    "Q03": "枚举越界 / 数值区间越界 / 小数位超出契约位数",
    "Q04": "时标错位：区间起点不等于业务日 + (时段号-1) 小时，或提交日与交易日不一致，或结算日早于电量归属日",
    "Q05": "单位声明缺失或与契约单位不一致（可换算则 WARN 并记录换算率）",
    "Q06": "逻辑异常：金额≠电量×价格（容差 0.01 元）、日历与工作日标志矛盾",
    "I01": "标准模板指纹不符（表头列名与顺序的 SHA-256 不匹配）",
    "I02": "PDF 无文本层（不做 OCR）",
    "I03": "单位无法换算（换算因子缺失或未知单位）",
    "I04": "映射缺必需字段，或模板数据字典与映射不一致",
    "I05": "批次行数超限",
    "I06": "15 分钟聚合点数不足 4（沿用时间栅格 T7 降级为 PARTIAL/MISSING）",
    "W09": "外部通道失败降级（不影响其它数据集）"
  },
