  "exclusive_groups": {
    "SPOT_BASIS": {
      "choose": [
        "W_SPOT_REF",
        "W_SPOT_DA+W_SPOT_RT",
        "W_CONTRACT_DIFF"
      ],
      "rule": "同一期间只能启用一组现货结算口径；混用即 BLOCK。W_CONTRACT_DIFF 与 W_CONTRACT 不可同时启用。"
    }
  },
  "formula_families": {
    "DIRECT": {
      "expression": "amount = q × p",
      "inputs": [
        "q",
        "p"
      ],
      "notes": "数量×价格；q 与 p 必须同期间、同主体、同科目。"
    },
    "SPOT_RESIDUAL": {
      "expression": "amount = (q_actual − q_contract) × p_ref",
      "inputs": [
        "q_actual",
        "q_contract",
        "p_ref"
      ],
      "notes": "合同外电量按参考点价；允许 q_actual < q_contract 产生负电量（回购），符号保留。"
    },
    "SPOT_RT": {
      "expression": "amount = (q_actual − q_da) × p_rt",
      "inputs": [
        "q_actual",
        "q_da",
        "p_rt"
      ]
    },
    "CONTRACT_DIFF": {
      "expression": "amount = q_contract × (p_contract − p_ref)",
      "inputs": [
        "q_contract",
        "p_contract",
        "p_ref"
      ]
    },
    "TIERED": {
      "expression": "r = (q_actual − q_contract) / q_contract; amount = Σ tier_energy × tier_rate",
      "inputs": [
        "q_actual",
        "q_contract",
        "tiers",
        "basis"
      ],
      "tier_shape": {
        "lower": "比率下界（含）",
        "upper": "比率上界（不含；null=无上界）",
        "rate": "元/MWh"
      },
      "rules": [
        "q_contract = 0 且 q_actual ≠ 0 → BLOCK ZERO_CONTRACT_DENOMINATOR，不猜。",
        "r < 0 时按绝对值查分段，费率符号由规则给出；不默认对称。",
        "分段电量按边界计算，最后一段吸收全部剩余；分段金额不中间舍入。"
      ]
    },
    "ALLOCATION": {
      "expression": "amount = pool_amount × share_ratio",
      "inputs": [
        "pool_amount",
        "share_ratio"
      ],
      "rules": [
        "同一分摊池的多行分摊比例合计必须为 1（1e-6 容差），单行表示本公司占比时 0≤ratio≤1；残差按最大余数法归到 0.01 元。"
      ]
    },
    "GREEN_SPLIT": {
      "expression": "green_total = q_green × (p_energy + p_env)",
      "inputs": [
        "q_green",
        "p_green_energy",
        "p_green_env"
      ],
      "rules": [
        "green_total 必须已包含在 R_ENERGY 中；环境价值单列，不重复计入总收入。"
      ]
    },
    "RETRO": {
      "expression": "amount = recomputed_amount − settled_amount",
      "inputs": [
        "recomputed_amount",
        "settled_amount",
        "related_month",
        "retro_seq"
      ],
      "rules": [
        "related_month 必填；跨自然年原则上 BLOCK（规则例外需审批记录）。",
        "retro_seq=0 为原单，>0 为调整；不得覆盖原单。"
      ]
    },
    "MARGIN": {
      "expression": "gross_margin = retail_revenue − wholesale_cost + adjustment",
      "inputs": [
        "retail_revenue",
        "wholesale_cost",
        "adjustment"
      ],
      "rules": [
        "按用户/科目分解的毛利之和必须等于总额，残差 0.00 元。"
      ]
    }
  },
  "totals": {
    "T_WHOLESALE_COST": {
      "include_direction": "BUY",
      "exclude_memo": true,
      "formula": "Σ item.amount (direction=BUY, included_in_totals=true)"
    },
    "T_RETAIL_REVENUE": {
      "include_direction": "SELL",
      "exclude_memo": true,
      "formula": "Σ item.amount (direction=SELL, included_in_totals=true)"
    },
    "T_ADJUSTMENT": {
      "include_codes": [
        "A_RETRO",
        "A_OTHER_ALLOC"
      ],
      "formula": "Σ signed amounts"
    },
    "T_GROSS_MARGIN": {
      "formula": "T_RETAIL_REVENUE − T_WHOLESALE_COST + T_ADJUSTMENT"
    }
  },
