{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccs.local/spec/settlement-replay/settlement.schema.json",
  "title": "结算复现与对账口径 v1.0",
  "version": "1.0.0",
  "status": "ACTIVE",
  "date": "2026-11-05",
  "ticket": "55",
  "map": "22",
  "description": "M03 结算复现中心的机器可读执行口径：科目目录、公式族、曲线分解、匹配、容差、差异分类、报告结构与参数注册表。",
  "principles": [
    "复现不是重新定价：用当时有效的规则参数重算同一批事实。",
    "每一分钱必须落到科目、时段、数量、价格、规则出处五项；落不进去的钱不进报表。",
    "数量守恒、金额守恒、符号一致；分项之和必须等于总额。",
    "缺失不补零、不插值；无法解释的差异不是容差，是缺陷。",
    "容差是双方确认的验收参数，不是系统可调的误差吸收器。",
    "同一输入必须得到同一输出：Decimal、固定排序、幂等、可哈希。"
  ],
  "axioms": {
    "S-A1": "单一账本：同一主体同一期间只有一套复现账；内部科目与官方科目通过显式映射表连接。",
    "S-A2": "时间切片：规则参数、合同版本、账单版本都按 as_of 解析，禁止用未来版本重算历史。",
    "S-A3": "守恒：分项金额之和等于总额；合同曲线分解前后电量相等；批零毛利分解残差为零。",
    "S-A4": "可追溯：每条结算行可回到规则文件+条款+版本+参数集+原始批次。",
    "S-A5": "差异必分类：UNEXPLAINED 数量必须为 0 才可能 PASS。",
    "S-A6": "只读复现：引擎不写回 D09/D10 历史数据，只产出派生结果与报告。"
  },
  "scope": {
    "subject_scope": "COMPANY",
    "subject_scope_note": "官方日清/月结按单一售电公司口径复现；用户/合同层为内部推导层，不假设官方账单提供用户维度。Q02 样本若显示官方分用户，按扩展票处理。",
    "period": {
      "daily": "自然日 00:00–24:00，24 个小时时段（#26）",
      "monthly": "自然月；结算周期可由 settlement_period 参数化，但默认自然月（#26 T10）",
      "energy_date": "按 interval_start 归属（#26 T9）",
      "settle_date": "不用于反推 energy_date（#26 T10）"
    },
    "out_of_scope": [
      "年度清算（次年 2 月底前）不在首期；只做日清与月结。",
      "发票、税务申报、资金支付不进入复现账。",
      "自动申报与真实交易写入不进入本规格（A12）。"
    ]
  },
