  "rules": [
    {
      "rule_id": "R-N07-01",
      "check_id": "N07-C01",
      "title": "认证申请要素完整性",
      "evidence": "认证申请书、CNCA 5.1 认证申请条款",
      "method": "按 5.1 逐要素核对申请信息（申请人、地址、范围、体系、场所等）是否填写并可定位",
      "acceptance": "5.1 所列申请要素全部有填写内容且可定位到申请书具体位置",
      "failure": "要素缺失→登记 missing 并转「等待补件」"
    },
    {
      "rule_id": "R-N07-02",
      "check_id": "N07-C02",
      "title": "申请评审条件逐条打勾",
      "evidence": "CNCA 5.2 申请评审条款、条件检查表",
      "method": "把 5.2 条件拆成可逐条打勾的检查项，逐项打勾并登记证据与锚点",
      "acceptance": "每个检查项都有明确结论（具备、待核、缺失）与证据位置，无未打勾项",
      "failure": "检查项无结论→保持 pending 并转「等待补件」；结论为待核→登记 pending_check"
    },
    {
      "rule_id": "R-N07-03",
      "check_id": "N07-C03",
      "title": "申请范围与实际场所一致性",
      "evidence": "申请范围、场所清单、N03 缺口台账与场所对应表",
      "method": "把申请范围与场所逐项对照，检查是否存在申请未覆盖但实际开展活动的场所",
      "acceptance": "申请范围与实际场所一致，超出或遗漏项已全部登记",
      "failure": "范围与场所不一致→登记 conflict 并转「等待人员确认」"
    },
    {
      "rule_id": "R-N07-04",
      "check_id": "N07-C04",
      "title": "体系建立与运行证据就绪度",
      "evidence": "体系文件与运行记录清单、N04 与 N05 台账",
      "method": "判断体系是否已建立并有运行证据，事实状态上限 material_supported，不评价有效性",
      "acceptance": "体系建立与运行有材料支撑并可定位，本节点结论只表述为就绪或未就绪",
      "failure": "证据缺失→登记 missing，结论只能落 insufficient；不得写成过程有效性结论"
    },
    {
      "rule_id": "R-N07-05",
      "check_id": "N07-C05",
      "title": "依据条款清单与依据快照状态",
      "evidence": "拟申请依据条款清单、依据库快照状态",
      "method": "逐条款核验快照状态（current、superseded、unverifiable、未登记）并登记来源定位",
      "acceptance": "每条拟引用条款都有 current 状态的快照与来源定位",
      "failure": "未登记→转「等待补件」；superseded→转「等待补件」；unverifiable→该条款只能落 insufficient"
    },
    {
      "rule_id": "R-N07-06",
      "check_id": "N07-C06",
      "title": "不予受理情形排查",
      "evidence": "CNCA 5.2 受理条件、申请材料与登记信息",
      "method": "按受理条件逐项排查不予受理情形，每种情形给出成立或不成立及其依据",
      "acceptance": "全部不予受理情形都有排查结论，不成立项有依据支撑",
      "failure": "情形成立但未登记→本项不合格，补齐后重新校验；判定依据不明→转「等待人员确认」"
    },
    {
      "rule_id": "R-N07-07",
      "check_id": "N07-C07",
      "title": "资格结论的人工确认与口径约束",
      "evidence": "条件检查表、就绪度判定记录、不予受理排查表",
      "method": "把逐条结果提交具名责任人得出结论，工具只提供依据摘要；校验结论措辞不含过程有效性表述",
      "acceptance": "结论由具名责任人确认并有确认时间，结论措辞限定在就绪度口径内",
      "failure": "未确认→保持 pending，转「等待人员确认」；结论含有效性表述→改回就绪度口径并重新确认"
    }
  ],
