  "rules": [
    {
      "rule_id": "R-N08-01",
      "check_id": "N08-C01",
      "title": "认证机构选择过程记录",
      "evidence": "选择记录、比选或询价材料（如有）",
      "method": "核对选择依据是否留痕并可定位，记录选择结果与时间",
      "acceptance": "选择过程有可定位记录，选择结果明确且与申请范围匹配",
      "failure": "无记录→转「等待补件」；选择与范围不匹配→登记 conflict 并转「等待人员确认」"
    },
    {
      "rule_id": "R-N08-02",
      "check_id": "N08-C02",
      "title": "申请材料完整性与提交清单核对",
      "evidence": "申请材料清单、实际提交件",
      "method": "按清单逐件核对提交情况，登记缺失与不可读件",
      "acceptance": "清单每项都有提交状态，缺失与不可读件已登记并有补交安排",
      "failure": "清单缺失→转「等待补件」；件不可读→登记 unreadable"
    },
    {
      "rule_id": "R-N08-03",
      "check_id": "N08-C03",
      "title": "申请书签署与授权有效性核对",
      "evidence": "申请书签署页、授权委托材料",
      "method": "核对签署人身份与授权范围是否覆盖本次申请",
      "acceptance": "签署人与授权材料匹配，授权范围覆盖申请事项",
      "failure": "授权缺失或过期→转「等待补件」；签署人不符→登记 conflict 并转「等待人员确认」"
    },
    {
      "rule_id": "R-N08-04",
      "check_id": "N08-C04",
      "title": "认证合同与相关责任约定齐备性核对",
      "evidence": "认证合同、CNCA 5.3 认证合同及相关责任条款",
      "method": "按 5.3 核对合同中应明确的事项是否齐备，登记缺项",
      "acceptance": "5.3 规定的合同事项全部齐备并可定位",
      "failure": "缺项→登记 missing 并转「等待补件」；条款互相矛盾→登记 conflict"
    },
    {
      "rule_id": "R-N08-05",
      "check_id": "N08-C05",
      "title": "合同签署与生效状态核对",
      "evidence": "合同签署页、生效条件说明",
      "method": "核对签署与生效条件是否满足，登记签署方与时间",
      "acceptance": "合同已签署且生效条件满足，签署方可定位",
      "failure": "未签署或生效条件未满足→转「等待补件」，不得推进到 N09"
    },
    {
      "rule_id": "R-N08-06",
      "check_id": "N08-C06",
      "title": "关键标识登记与外部编号隔离",
      "evidence": "合同编号、申请编号等标识",
      "method": "登记外部标识原值，不在本节点写入机构内部编号或未经确认的编号规则",
      "acceptance": "标识原值已登记且与来源文件一致，生成物中的编号占位符按 S4 字典替换",
      "failure": "标识与来源不一致→登记 conflict；占位符残留→按 S4 §9.2 校验并改正"
    }
  ],
