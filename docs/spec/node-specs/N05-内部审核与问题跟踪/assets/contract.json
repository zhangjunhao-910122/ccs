  "rules": [
    {
      "rule_id": "R-N05-01",
      "check_id": "N05-C01",
      "title": "内部审核策划覆盖与审核准则核对",
      "evidence": "内部审核方案与计划、GB/T 19001-2016 9.2",
      "method": "核对策划覆盖的过程与准则、审核方式与频次安排，把每项定位到策划材料的具体位置",
      "acceptance": "策划覆盖范围与准则可定位到材料，并与 GB/T 19001-2016 9.2 的要求逐项对应",
      "failure": "策划材料缺失→转「等待补件」；覆盖不全→登记 missing 并转入缺口台账"
    },
    {
      "rule_id": "R-N05-02",
      "check_id": "N05-C02",
      "title": "内审员能力与独立性记录核对",
      "evidence": "内审员能力评价记录、独立性声明或回避记录、GB/T 19001-2016 9.2",
      "method": "逐名核对能力评价与独立性证据，记录证据位置与结论",
      "acceptance": "每名内审员都有能力评价与独立性证据并可定位到具体记录",
      "failure": "记录缺失→登记 missing 并转「等待补件」；独立性存疑→登记 conflict 并转「等待人员确认」"
    },
    {
      "rule_id": "R-N05-03",
      "check_id": "N05-C03",
      "title": "内审证据与不符合项记录核对",
      "evidence": "内审检查记录、抽样记录、内审不符合项记录",
      "method": "逐条核对不符合项是否有对应的观察事实与证据位置，不评价证据背后的判断",
      "acceptance": "每条内审不符合项都有可定位的观察事实与证据位置，抽样记录六字段齐全",
      "failure": "缺观察事实或证据→登记 missing；抽样六字段缺一→该条只能落 insufficient 并登记 SAMPLING_INSUFFICIENT"
    },
    {
      "rule_id": "R-N05-04",
      "check_id": "N05-C04",
      "title": "内审报告与结果记录核对",
      "evidence": "内审报告、内审结果通报或记录",
      "method": "核对报告是否覆盖全部内审活动与不符合项结论，登记报告与台账的差异",
      "acceptance": "报告覆盖全部内审活动与不符合项，与台账条目一致",
      "failure": "报告缺项或与台账不一致→登记 conflict 并转「等待人员确认」"
    },
    {
      "rule_id": "R-N05-05",
      "check_id": "N05-C05",
      "title": "不符合项闭环跟踪与台账状态一致性",
      "evidence": "不符合项台账、纠正与验证记录、GB/T 19001-2016 9.2",
      "method": "逐条核对台账状态与支撑记录是否一致，记录状态变化的取得时间与来源",
      "acceptance": "每条台账状态都有对应支撑记录，且状态取值合法",
      "failure": "状态无支撑记录→登记 missing；状态与记录矛盾→登记 conflict 并转「等待人员确认」"
    },
    {
      "rule_id": "R-N05-06",
      "check_id": "N05-C06",
      "title": "访谈类与时间序列类事实的取证限制",
      "evidence": "内审访谈记录、内审有效性相关记录、审核点库照片取证白名单",
      "method": "逐条判定内审相关事实是否落在访谈类或时间序列类之内，命中即改用书面记录或访谈记录并写明取证要求",
      "acceptance": "命中项已写明替代取证方式，且相关审核点不以照片作为唯一证据",
      "failure": "仍以照片为唯一证据→登记 conflict 并转「等待补件」，同时提示该审核点判定只能落 insufficient"
    }
  ],
