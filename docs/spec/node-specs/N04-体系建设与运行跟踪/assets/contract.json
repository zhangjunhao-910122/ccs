  "rules": [
    {
      "rule_id": "R-N04-01",
      "check_id": "N04-C01",
      "title": "体系文件清单与受控版本核对",
      "evidence": "体系文件清单、文件封面或发布页、版本号与发布日期",
      "method": "逐件记录文件基名与受控版本，把版本信息定位到封面或发布记录的具体位置",
      "acceptance": "每件体系文件都有受控版本、发布日期与来源位置，无版本不明文件",
      "failure": "版本或发布日期不可回指→转「等待补件」；同名不同版本→登记 conflict 并转「等待人员确认」"
    },
    {
      "rule_id": "R-N04-02",
      "check_id": "N04-C02",
      "title": "过程与流程文件覆盖核对",
      "evidence": "过程清单、流程文件、GB/T 19001-2016 4.4",
      "method": "把每个过程与对应文件逐项对照，标出无文件支撑的过程",
      "acceptance": "每个已识别过程都有对应文件或已登记的缺口说明",
      "failure": "过程无文件支撑→登记 missing 并转入缺口台账；范围不一致→登记 conflict"
    },
    {
      "rule_id": "R-N04-03",
      "check_id": "N04-C03",
      "title": "过程运行准则与信息可获得性核对",
      "evidence": "过程运行方法说明、GB/T 19001-2016 7.1.5",
      "method": "检查每个过程的运行准则、监测要求与必要信息是否在文件或记录中可获得",
      "acceptance": "每个过程的运行准则与必要信息均有材料支撑且可定位",
      "failure": "准则或信息缺失→登记 missing 并转入缺口台账"
    },
    {
      "rule_id": "R-N04-04",
      "check_id": "N04-C04",
      "title": "岗位职责与授权文件一致性核对",
      "evidence": "岗位职责文件、授权文件、人员清单",
      "method": "把岗位职责文件与授权文件逐项对照，登记不一致与空缺岗位",
      "acceptance": "每个岗位都有明确职责与授权依据，不一致项已登记并有处理结论",
      "failure": "职责与授权冲突→登记 conflict 并转「等待人员确认」；岗位空缺→登记 missing"
    },
    {
      "rule_id": "R-N04-05",
      "check_id": "N04-C05",
      "title": "运行记录存在与保存核对",
      "evidence": "运行记录样本、记录保存位置与保存期限说明",
      "method": "核对记录是否存在、是否可定位到具体时间与具体过程，只记录观察到的内容",
      "acceptance": "每个被抽查过程的运行记录均可定位且字段完整，缺失项已登记为 missing",
      "failure": "记录缺失或不可读→登记 missing 或 unreadable，转「等待补件」"
    },
    {
      "rule_id": "R-N04-06",
      "check_id": "N04-C06",
      "title": "跟踪提醒与到期复核安排",
      "evidence": "缺口台账、文件跟踪清单、运行记录核对表中的未完成项",
      "method": "为每个未完成项登记跟踪事项、责任方与期望回复时间，不代替受审核方实施",
      "acceptance": "每个未完成项都有跟踪事项与责任方，无未登记的未完成项",
      "failure": "存在未登记的未完成项→本项不合格，补齐后重新校验"
    }
  ],
