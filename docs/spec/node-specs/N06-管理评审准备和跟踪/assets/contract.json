  "rules": [
    {
      "rule_id": "R-N06-01",
      "check_id": "N06-C01",
      "title": "管理评审策划与频次覆盖核对",
      "evidence": "管理评审策划与通知、GB/T 19001-2016 9.3.1",
      "method": "核对策划载明的频次、覆盖过程与组织范围，把每项定位到策划材料的具体位置",
      "acceptance": "策划频次与覆盖范围可定位到材料，并与 GB/T 19001-2016 9.3.1 的要求逐项对应",
      "failure": "策划材料缺失→转「等待补件」；覆盖不全→登记 missing 并转入缺口台账"
    },
    {
      "rule_id": "R-N06-02",
      "check_id": "N06-C02",
      "title": "管理评审输入项覆盖核对",
      "evidence": "管理评审输入材料清单、GB/T 19001-2016 9.3.2",
      "method": "逐项核对 9.3.2 所列输入在材料中的可见性，登记未提供项与原因",
      "acceptance": "9.3.2 各项输入要么有材料支撑，要么有书面说明的未提供原因",
      "failure": "输入项缺失且无原因说明→登记 missing 并转「等待补件」"
    },
    {
      "rule_id": "R-N06-03",
      "check_id": "N06-C03",
      "title": "最高管理者主持与参加核对",
      "evidence": "评审通知、签到或参加记录、GB/T 19001-2016 9.3.3",
      "method": "核对主持与参加身份是否可定位到记录位置，只记录看到的事实",
      "acceptance": "最高管理者主持与参加情况有可定位记录，身份与角色明确",
      "failure": "记录缺失→登记 missing，相关审核点判定只能落 insufficient；记录互相矛盾→登记 conflict 并转「等待人员确认」"
    },
    {
      "rule_id": "R-N06-04",
      "check_id": "N06-C04",
      "title": "评审输出（决定与措施）核对",
      "evidence": "管理评审输出记录、输出措施清单、GB/T 19001-2016 9.3.3",
      "method": "逐条核对输出的决定、措施、资源与责任，定位到输出记录位置",
      "acceptance": "每条输出措施都有明确内容、资源与责任，可回指到输出记录",
      "failure": "措施缺责任或资源表述→登记 missing；输出记录不可读→登记 unreadable"
    },
    {
      "rule_id": "R-N06-05",
      "check_id": "N06-C05",
      "title": "输出措施跟踪与内审问题台账一致性",
      "evidence": "措施跟踪记录、内审问题台账、措施关闭证据",
      "method": "把措施跟踪状态与内审台账交叉核对，登记状态差异与关闭依据",
      "acceptance": "措施状态与台账一致，关闭项有可定位的关闭依据",
      "failure": "状态不一致→登记 conflict 并转「等待人员确认」；关闭无依据→登记 missing"
    },
    {
      "rule_id": "R-N06-06",
      "check_id": "N06-C06",
      "title": "管理评审有效性的取证限制声明",
      "evidence": "管理评审相关事实的证据清单、审核点库照片取证白名单",
      "method": "逐条判定管理评审相关事实是否落在时间序列类之内，命中即改用连续记录或书面证据并写明取证要求",
      "acceptance": "命中项已写明替代取证方式，且不出现以单张照片推断管理评审有效性的表述",
      "failure": "仍以照片为唯一证据→登记 conflict 并转「等待补件」，同时提示该审核点判定只能落 insufficient"
    }
  ],
