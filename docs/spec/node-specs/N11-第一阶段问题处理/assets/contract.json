      "rule_id": "R-N11-03",
      "check_id": "N11-C03",
      "title": "原因分析材料登记",
      "evidence": "原因分析材料、GB/T 19001-2016 10.2 相关要求",
      "method": "登记原因分析材料的来源、位置与覆盖范围，只记录材料写了什么",
      "acceptance": "每条待处理问题都有可定位的原因分析材料",
      "failure": "材料缺失→登记 missing 并转「等待补件」；材料不可读→登记 unreadable"
    },
    {
      "rule_id": "R-N11-04",
      "check_id": "N11-C04",
      "title": "纠正措施与整改计划登记",
      "evidence": "纠正措施材料、整改计划",
      "method": "登记措施内容、责任、资源与计划安排，定位到材料位置",
      "acceptance": "每条问题都有明确措施、责任与计划安排并可定位",
      "failure": "措施缺责任或计划→登记 missing 并转「等待补件」"
    },
    {
      "rule_id": "R-N11-05",
      "check_id": "N11-C05",
      "title": "整改实施证据登记与一致性核对",
      "evidence": "整改实施证据、台账状态",
      "method": "登记实施证据并与台账状态交叉核对，登记差异",
      "acceptance": "台账状态与证据一致，状态变化有取得时间与来源",
      "failure": "状态无证据→登记 missing；状态与证据矛盾→登记 conflict 并转「等待人员确认」"
    },
    {
      "rule_id": "R-N11-06",
      "check_id": "N11-C06",
      "title": "未闭环问题与提醒登记",
      "evidence": "台账未闭环条目、未决事项清单",
