{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ccs/docs/spec/node-specs/contract.schema.json",
  "title": "节点机器可读契约 contract.json",
  "description": "docs/spec/node-specs/<节点编号>-<名称>/assets/contract.json 的结构约束，schema_version 固定为 1。",
  "type": "object",
  "required": [
    "schema_version",
    "node",
    "title",
    "previous",
    "next",
    "formal_name",
    "brief_name",
    "completion",
    "rules",
    "sections",
    "required_authority",
    "sources",
    "business_authorization",
    "substep_policy"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "node": {
      "type": "string",
      "pattern": "^N(0[1-9]|1[0-7])$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "previous": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nodeId"
      },
      "uniqueItems": true
    },
    "next": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nodeId"
      },
      "uniqueItems": true
    },
    "formal_name": {
      "type": "string",
      "minLength": 1
    },
    "brief_name": {
      "type": "string",
      "minLength": 1
    },
    "completion": {
      "type": "object",
      "required": [
        "checklist",
        "handover_preconditions",
        "state_alignment"
      ],
      "additionalProperties": false,
      "properties": {
        "checklist": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "condition",
              "evidence",
              "initial_status"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^N(0[1-9]|1[0-7])-C[0-9]{2}$"
              },
              "condition": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              },
              "initial_status": {
                "type": "string",
                "const": "未执行"
              }
            }
          }
        },
        "handover_preconditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "state_alignment": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "waiting",
              "review",
              "final",
              "terminated"
            ]
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "check_id",
          "title",
          "evidence",
          "method",
          "acceptance",
          "failure"
        ],
        "additionalProperties": false,
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^R-N(0[1-9]|1[0-7])-[0-9]{2}$"
          },
          "check_id": {
            "type": "string",
            "pattern": "^N(0[1-9]|1[0-7])-C[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "acceptance": {
            "type": "string",
            "minLength": 1
          },
          "failure": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "section_id",
          "document",
          "title",
          "basis"
        ],
        "additionalProperties": false,
        "properties": {
          "section_id": {
            "type": "string",
            "pattern": "^N(0[1-9]|1[0-7])\\.S[0-9]{2}$"
          },
          "document": {
            "type": "string",
            "enum": [
              "节点执行规范",
              "审核规则规范",
              "成果与完成交接规范"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "required_authority": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "authority",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "business_authorization": {
      "type": "object",
      "required": [
        "gates",
        "signature_boundary",
        "prohibitions"
      ],
      "additionalProperties": false,
      "properties": {
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "gate_id",
              "name",
              "approver",
              "non_automatable",
              "tool_behavior",
              "source"
            ],
            "additionalProperties": false,
            "properties": {
              "gate_id": {
                "type": "string",
                "enum": [
                  "G1",
                  "G2",
                  "G3",
                  "G4",
                  "G5",
                  "G6"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "approver": {
                "type": "string",
                "minLength": 1
              },
              "non_automatable": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "tool_behavior": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "signature_boundary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prohibitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "substep_policy": {
      "type": "object",
      "required": [
        "parallel_execution",
        "missing_input_action",
        "resume_action",
        "rollback_record_fields",
        "handoff_record_fields",
        "handoff_append_only"
      ],
      "additionalProperties": false,
      "properties": {
        "parallel_execution": {
          "type": "boolean",
          "const": false
        },
        "missing_input_action": {
          "type": "string",
          "minLength": 1
        },
        "resume_action": {
          "type": "string",
          "minLength": 1
        },
        "rollback_record_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "handoff_record_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "handoff_append_only": {
          "type": "boolean",
          "const": true
        }
      }
    }
  },
  "$defs": {
    "nodeId": {
      "type": "string",
      "pattern": "^N(0[1-9]|1[0-7])$"
    }
  }
}
