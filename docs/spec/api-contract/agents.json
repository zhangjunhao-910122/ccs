{
  "name": "Agent 工具契约",
  "version": "1.0.0",
  "ticket": "#46",
  "effects": [
    "READ",
    "PROPOSE",
    "SIMULATE"
  ],
  "forbidden_effects": [
    "EXECUTE"
  ],
  "note": "effect=EXECUTE 为编译期非法；工具输入/输出 schema 由本文件登记，运行时校验；must_cite 工具无引用即失败",
  "agents": [
    {
      "id": "rule_coach",
      "title": "规则教练Agent",
      "duty": "规则问答、课程、考试和规则变更解释",
      "dimension": "RULE_LEARNING",
      "tools": [
        {
          "id": "answer_rule_question",
          "title": "可追溯规则问答",
          "effect": "READ",
          "requires_context": [
            "as_of"
          ],
          "must_cite": true,
          "sensitive_datasets": [],
          "input_schema": {
            "type": "object",
            "required": [
              "question"
            ],
            "properties": {
              "question": {
                "type": "string",
                "description": "自然语言问题，≤500 字"
              },
              "as_of": {
                "type": "string",
                "description": "规则时点；缺省取 context.as_of"
              }
            },
            "additionalProperties": false
          },
          "output_schema": {
            "type": "object",
            "required": [
              "answer",
              "citations"
            ],
            "properties": {
              "answer": {
                "type": "string",
                "description": "结论句，须含适用条件"
              },
              "citations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object"
                }
              }
            },
            "additionalProperties": false
          }
        },
        {
          "id": "explain_change",
          "title": "规则变更解释",
          "effect": "READ",
          "requires_context": [
            "as_of"
          ],
          "must_cite": true,
          "sensitive_datasets": [],
          "input_schema": {
            "type": "object",
            "required": [
              "doc_id"
            ],
            "properties": {
              "doc_id": {
                "type": "string",
                "description": "规则文件"
              },
              "from_version": {
                "type": "string",
                "description": "对比起始版本"
              },
              "to_version": {
                "type": "string",
                "description": "对比目标版本"
              }
            },
            "additionalProperties": false
          },
          "output_schema": {
            "type": "object",
            "required": [
              "changes",
              "citations"
            ],
            "properties": {
              "changes": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "citations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object"
                }
              }
            },
            "additionalProperties": false
          }
        }
      ]
    },
    {
