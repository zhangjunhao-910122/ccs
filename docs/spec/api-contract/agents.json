              },
              "forecast_origin": {
                "type": "string",
                "description": "起点"
              },
              "points": {
                "type": "array",
                "minItems": 24,
                "maxItems": 24,
                "items": {
                  "type": "object"
                }
              }
            },
            "additionalProperties": false
          }
        },
        {
          "id": "explain_error",
          "title": "预测误差归因",
